{
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check **/*.ts && deno check **/*.tsx",
    "dev": "deno run -A --watch=static/,routes/ dev.ts",
    "build": "deno run -A dev.ts build",
    "start": "deno run -A main.ts",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "nodeModulesDir": "auto",
  "imports": {
    "@kuboon/tailwindcss-deno": "jsr:@kuboon/tailwindcss-deno@^0.1.2",
    "@tailwindcss/oxide": "npm:@tailwindcss/oxide@^4.2.2",
    "daisyui": "npm:daisyui@^5.5.19",
    "fresh": "jsr:@fresh/core@^2.2.2",
    "preact": "npm:preact@^10.29.0",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "tailwindcss": "npm:tailwindcss@^4.2.2"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ]
  },
  "unstable": ["kv"]
}
